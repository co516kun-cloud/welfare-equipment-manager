# Supabase環境変数
# SupabaseダッシュボードのSettings > APIから取得してください

# Project URL (例: https://xxxxx.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Anon/Public Key
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# 天気API環境変数
# WeatherAPI.com から無料APIキーを取得してください
# https://www.weatherapi.com/

# Weather API Key
VITE_WEATHER_API_KEY=your-weather-api-key-here

# Weather Location (デフォルト: Tokyo)
VITE_WEATHER_LOCATION=Tokyo

# ラベル印刷エージェント（mcp-server/src/print-agent）
# PC 常駐で label_print_queue を拾って Brother QL-800 に印刷する。
# Supabase Auth のユーザー（メール+パスワード）が必要。専用アカウントを1つ作るのが望ましい。
# 未設定なら MCP_USER_EMAIL / MCP_USER_PASSWORD を流用する。
PRINT_AGENT_EMAIL=
PRINT_AGENT_PASSWORD=
# printed_by に入る名前（省略時: print-agent@<PC名>）
# PRINT_AGENT_NAME=
# polling 間隔 ms（省略時: 15000。Realtime が効いていれば実際は 1〜3 秒で拾う）
# PRINT_AGENT_POLL_MS=
# プリンタ名（省略時: Brother QL-800）
# LABEL_PRINTER_NAME=
# print-label.ps1 の Windows パス（省略時: リポジトリから自動計算）
# LABEL_PRINT_SCRIPT=

# 注意事項：
# 1. このファイルを.envにコピーしてください
# 2. 実際の値を入力してください
# 3. .envファイルは絶対にGitにコミットしないでください